{
  "name": "kotamusic-installer",
  "version": "1.0.0",
  "description": "Установщик модификации KotaMusic для Яндекс Музыки",
  "main": "src/main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "package": "electron-builder --publish never"
  },
  "build": {
    "appId": "su.lvl.kotamusic.installer",
    "productName": "KotaMusic",
    "files": [
      "src/**/*",
      "!**/*.map"
    ],
    "win": {
      "target": "nsis",
      "artifactName": "KotaMusic-Setup-${version}.${ext}",
      "icon": "build/icon.png"
    },
    "mac": {
      "target": "dmg",
      "artifactName": "KotaMusic-${version}.${ext}",
      "icon": "build/icon.png",
      "category": "public.app-category.utilities"
    },
    "linux": {
      "target": "AppImage",
      "artifactName": "KotaMusic-${version}.${ext}",
      "icon": "build/icon.png",
      "category": "Utility"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false,
      "artifactName": "KotaMusic-Setup-${version}.${ext}",
      "shortcutName": "KotaMusic",
      "uninstallDisplayName": "KotaMusic"
    },
    "copyright": "KotaMusic",
    "directories": {
      "buildResources": "build",
      "output": "dist"
    }
  },
  "devDependencies": {
    "electron": "^38.8.6",
    "electron-builder": "^26.15.3"
  },
  "author": "Harrisan",
  "license": "MIT"
}